{
  "name": "allnova-gewinnspiel-videos",
  "private": true,
  "type": "module",
  "description": "Motion-Design-Animationen (HTML + GSAP), deterministisch gerendert zu MP4 1080x1920",
  "scripts": {
    "sound": "python3 sound/sounddesign.py",
    "render": "python3 sound/sounddesign.py && node render.mjs",
    "render:steuer": "node render.mjs steuer",
    "render:fahrstart": "node render.mjs fahrstart",
    "preview": "npx http-server . -p 8080 -c-1"
  },
  "dependencies": {
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "playwright-core": "1.56.1"
  }
}
