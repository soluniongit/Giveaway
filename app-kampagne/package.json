{
  "name": "allnova-app-kampagne",
  "private": true,
  "type": "module",
  "description": "allnova App-Kampagne: App-Teaser (HTML + GSAP → MP4 1080x1920) und Instagram-Visuals",
  "scripts": {
    "assets": "python3 teaser/build-assets.py",
    "sound": "python3 sound/sounddesign.py",
    "render": "python3 sound/sounddesign.py && node render.mjs teaser",
    "instagram": "node instagram/export.mjs",
    "preview": "npx http-server . -p 8090 -c-1"
  },
  "dependencies": {
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
